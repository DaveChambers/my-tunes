<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="MyTune1" name="My Tunes" projectType="guiapp"
              jucerFormatVersion="1" version="0.1.0"
              bundleIdentifier="com.makeelectronicsound.mytunes"
              companyName="Make Electronic Sound"
              companyWebsite="https://makeelectronicsound.com"
              cppLanguageStandard="17"
              displaySplashScreen="0"
              userNotes="DJ tune-organising macOS app. Sample-of-20 mode. Discogs cover lookup is opt-in via DISCOGS_USER_TOKEN env var. CMake build still works alongside this Projucer file — pick whichever workflow you prefer.">
  <MAINGROUP id="MTRoot" name="My Tunes">
    <GROUP id="SrcRoo" name="Source">
      <FILE id="myMain"  name="Main.cpp"                 compile="1" resource="0" file="Source/Main.cpp"/>
      <FILE id="myMcCp"  name="MainComponent.cpp"        compile="1" resource="0" file="Source/MainComponent.cpp"/>
      <FILE id="myMcHh"  name="MainComponent.h"          compile="0" resource="0" file="Source/MainComponent.h"/>
      <FILE id="myTfHh"  name="TrackFile.h"              compile="0" resource="0" file="Source/TrackFile.h"/>
      <FILE id="myTfpCp" name="TrackFilenameParser.cpp"  compile="1" resource="0" file="Source/TrackFilenameParser.cpp"/>
      <FILE id="myTfpHh" name="TrackFilenameParser.h"    compile="0" resource="0" file="Source/TrackFilenameParser.h"/>
      <FILE id="myTlbCp" name="TrackLibrary.cpp"         compile="1" resource="0" file="Source/TrackLibrary.cpp"/>
      <FILE id="myTlbHh" name="TrackLibrary.h"           compile="0" resource="0" file="Source/TrackLibrary.h"/>
      <FILE id="myTstCp" name="TrackStorage.cpp"         compile="1" resource="0" file="Source/TrackStorage.cpp"/>
      <FILE id="myTstHh" name="TrackStorage.h"           compile="0" resource="0" file="Source/TrackStorage.h"/>
      <FILE id="myDcCp"  name="DiscogsClient.cpp"        compile="1" resource="0" file="Source/DiscogsClient.cpp"/>
      <FILE id="myDcHh"  name="DiscogsClient.h"          compile="0" resource="0" file="Source/DiscogsClient.h"/>
      <FILE id="myAcCp"  name="ArtworkCache.cpp"         compile="1" resource="0" file="Source/ArtworkCache.cpp"/>
      <FILE id="myAcHh"  name="ArtworkCache.h"           compile="0" resource="0" file="Source/ArtworkCache.h"/>
      <FILE id="myLcCp"  name="LookupController.cpp"     compile="1" resource="0" file="Source/LookupController.cpp"/>
      <FILE id="myLcHh"  name="LookupController.h"       compile="0" resource="0" file="Source/LookupController.h"/>
      <FILE id="myPpCp"  name="TrackPreviewPlayer.cpp"   compile="1" resource="0" file="Source/TrackPreviewPlayer.cpp"/>
      <FILE id="myPpHh"  name="TrackPreviewPlayer.h"     compile="0" resource="0" file="Source/TrackPreviewPlayer.h"/>
      <FILE id="myMpCp"  name="MiniPlayerComponent.cpp"  compile="1" resource="0" file="Source/MiniPlayerComponent.cpp"/>
      <FILE id="myMpHh"  name="MiniPlayerComponent.h"    compile="0" resource="0" file="Source/MiniPlayerComponent.h"/>
      <FILE id="myTlcCp" name="TrackListComponent.cpp"   compile="1" resource="0" file="Source/TrackListComponent.cpp"/>
      <FILE id="myTlcHh" name="TrackListComponent.h"     compile="0" resource="0" file="Source/TrackListComponent.h"/>
      <FILE id="myTgcCp" name="TrackGridComponent.cpp"   compile="1" resource="0" file="Source/TrackGridComponent.cpp"/>
      <FILE id="myTgcHh" name="TrackGridComponent.h"     compile="0" resource="0" file="Source/TrackGridComponent.h"/>
      <FILE id="myEbCp"  name="EmojiTagBoardComponent.cpp" compile="1" resource="0" file="Source/EmojiTagBoardComponent.cpp"/>
      <FILE id="myEbHh"  name="EmojiTagBoardComponent.h"   compile="0" resource="0" file="Source/EmojiTagBoardComponent.h"/>
      <FILE id="myTdCp"  name="TrackDetailComponent.cpp" compile="1" resource="0" file="Source/TrackDetailComponent.cpp"/>
      <FILE id="myTdHh"  name="TrackDetailComponent.h"   compile="0" resource="0" file="Source/TrackDetailComponent.h"/>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics"    showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_devices"   showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_formats"   showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_core"            showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_events"          showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_graphics"        showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_basics"      showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_extra"       showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
  </MODULES>
  <JUCEOPTIONS JUCE_USE_CURL="0"
               JUCE_WEB_BROWSER="0"
               JUCE_STANDALONE_APPLICATION="1"
               JUCE_USE_MP3AUDIOFORMAT="1"/>
  <EXPORTFORMATS>
    <XCODE_MAC targetFolder="Builds/MacOSX">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug"   isDebug="1" optimisation="1" targetName="My Tunes"
                       osxCompatibility="10.13 SDK" macOSDeploymentTarget="10.13"/>
        <CONFIGURATION name="Release" isDebug="0" optimisation="3" linkTimeOptimisation="1"
                       targetName="My Tunes"
                       osxCompatibility="10.13 SDK" macOSDeploymentTarget="10.13"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics"    path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices"   path="../../JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats"   path="../../JUCE/modules"/>
        <MODULEPATH id="juce_core"            path="../../JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="../../JUCE/modules"/>
        <MODULEPATH id="juce_events"          path="../../JUCE/modules"/>
        <MODULEPATH id="juce_graphics"        path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics"      path="../../JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra"       path="../../JUCE/modules"/>
      </MODULEPATHS>
    </XCODE_MAC>
  </EXPORTFORMATS>
</JUCERPROJECT>
